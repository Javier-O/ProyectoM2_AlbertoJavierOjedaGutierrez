# Puerto donde corre el servidor Express
PORT=3000

# Datos de conexión a PostgreSQL
# Cuando despliegues en Railway, estas variables las tomas del servicio de Postgres que te crea ahí
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=miniblog

# Base de datos separada para correr los tests (Paso 7), así no se mezclan
# con tus datos de desarrollo. Créala igual que la de arriba y corre
# setup.sql + seed.sql también en ella.
DB_NAME_TEST=miniblog_test

# Alternativa: Railway suele dar una sola URL de conexión.
# Si la usas, puedes ignorar las 5 variables de arriba y usar esta en su lugar.
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd
